{
  "name": "readme-smith",
  "version": "0.2.0",
  "description": "本地优先的 README 健康医生：确定性事实、可审阅草稿，以及阻止 README 腐化的 CI 门禁。",
  "keywords": [
    "readme",
    "documentation",
    "health-check",
    "doctor",
    "cli",
    "ci",
    "linter",
    "local-first"
  ],
  "author": "yuwan41064 <yuwan41064@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/yuwan41064/readme-smith.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "bin": {
    "rf": "./dist/cli.js",
    "readme-smith": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.d.ts.map",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "action.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "node -e \"fs.rmSync('dist-test',{recursive:true,force:true})\" && tsc -p tsconfig.test.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('dist-test',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "pretest": "npm run clean && npm run build && npm run build:test",
    "test": "node --test \"dist-test/test/unit/**/*.test.js\"",
    "pretest:coverage": "npm run clean && npm run build && npm run build:test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"dist-test/src/**/*.js\" --test-coverage-exclude=\"dist-test/test/**\" --test-coverage-lines=80 --test-coverage-branches=70 --test-coverage-functions=80 \"dist-test/test/unit/**/*.test.js\"",
    "prepublishOnly": "npm run clean && npm run build",
    "self:doctor": "node dist/cli.js doctor .",
    "self:check": "node dist/cli.js check ."
  },
  "dependencies": {
    "commander": "^12.1.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
